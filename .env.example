# Anthropic credentials for bench-press. Set exactly one of the two below.
#
# To set up:
#   cp .env.example .env
#   # then edit .env and fill in ONE of the credentials
#
# Option 1 — Console API key (billed per-token):
#   Get a key at https://console.anthropic.com/settings/keys
#
# Option 2 — Claude subscription (Pro/Max) OAuth token, no API key needed:
#   Run `claude setup-token` (one-time browser flow) and paste the
#   sk-ant-oat01-... token it prints. Lasts ~1 year. Usage counts against
#   your subscription's rate limits, shared with interactive sessions.
#
# If both are set, the API key wins. Do NOT paste the short-lived claude.ai
# accessToken from the Keychain here — it is rejected as an API key and
# expires within hours.

ANTHROPIC_API_KEY=
CLAUDE_CODE_OAUTH_TOKEN=

# Claude Code model and effort level used inside the container.
# Effort levels for Fable 5: low / medium / high / xhigh / max.
# Other models fall back to `high`.
CLAUDE_MODEL=claude-fable-5
CLAUDE_EFFORT=xhigh

# ---------------------------------------------------------------------------
# Codex engine (./run.sh --engine codex) — set at most one credential.
#
# Option 1 — ChatGPT subscription (Plus/Pro), no API key needed:
#   Leave OPENAI_API_KEY empty and run `codex login` on the host (one-time
#   browser flow; writes ~/.codex/auth.json). run.sh mounts ~/.codex into
#   the container automatically.
#
# Option 2 — OpenAI API key (billed per-token):
#   Get a key at https://platform.openai.com/api-keys and paste it below.
#   If set, it wins over the ~/.codex login.

OPENAI_API_KEY=

# Codex model and reasoning effort for both the main run and rewrite step.
CODEX_MODEL=gpt-6-astra
CODEX_EFFORT=xhigh
